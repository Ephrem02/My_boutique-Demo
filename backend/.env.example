NODE_ENV=development
PORT=4000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=shop_management
DB_USER=postgres
DB_PASSWORD=postgres

JWT_SECRET=replace_with_output_of__openssl_rand_-hex_32__do_not_use_this_value
JWT_EXPIRES_IN=8h

# Comma-separated list of origins allowed to call this API (your POS web app, desktop app, etc.)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Production DB TLS (NODE_ENV=production only). By default the server's cert
# is verified. If your provider uses a CA not in the default trust store,
# paste its PEM cert into DB_SSL_CA. Only set DB_SSL_REJECT_UNAUTHORIZED=false
# as a last resort - it disables certificate verification entirely.
# DB_SSL_CA=
# DB_SSL_REJECT_UNAUTHORIZED=false

# Restricted runtime DB role (recommended). DB_USER/DB_PASSWORD above are the
# schema owner, used for migrations. When DB_APP_USER is set, the API connects
# as this role instead, which cannot UPDATE/DELETE/TRUNCATE audit_logs.
# `npm run migrate` creates/updates it; or run `npm run db:roles`.
# DB_APP_USER=shop_app
# DB_APP_PASSWORD=generate_with__openssl_rand_-hex_24

# Separate database for `npm test` (must end in _test - it is wiped by tests)
# DB_NAME_TEST=shop_management_test

# Number of reverse-proxy hops in front of the API (e.g. 1 behind nginx).
# Leave unset when clients connect directly. Needed for correct audit IPs.
# TRUST_PROXY=1

# Optional rate-limit overrides (requests per 15 minutes per IP)
# API_RATE_LIMIT=300
# LOGIN_RATE_LIMIT=10

# Notification email (SMTP). Credentials live only here - never in the DB.
# Email also stays off until an admin enables it in Admin > Notifications > Email.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false            # true for port 465 (implicit TLS)
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_TLS_REJECT_UNAUTHORIZED=true
# Link to the POS web app, included in notification emails
# APP_BASE_URL=http://localhost:5173
